# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# OpenAI (required — used by /api/plan, /api/packing, /api/photospot)
OPENAI_API_KEY=sk-...

# Anthropic (required — used by /api/parse-booking)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub (required — stores trip plans as secret Gists)
GITHUB_TOKEN=ghp_...

# Flight search and affiliate enrichment
SERPAPI_KEY=...
TRAVELPAYOUTS_TOKEN=...
TRAVELPAYOUTS_MARKER=529721
PEXELS_API_KEY=...
UNSPLASH_ACCESS_KEY=...
GYG_PARTNER_ID=529721
KLOOK_AID=...
TRIPCOM_ALLIANCE_CODE=...
KIWI_AFFILIATE_ID=...

# Stripe (required for Pro billing; endpoints return 503 without these)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...

# Web Push / VAPID (required for push notifications)
VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:hello@tripva.app
PUSH_CRON_TOKEN=...
CRON_SECRET=...

# Admin dashboard
ADMIN_EMAILS=alex@example.com

# Auth hardening
# Set to true in production to require Supabase JWTs on costly AI/search endpoints.
REQUIRE_AUTH_FOR_COSTLY_ENDPOINTS=false

# CORS (defaults to https://tripva.app if omitted)
ALLOWED_ORIGIN=https://tripva.app
